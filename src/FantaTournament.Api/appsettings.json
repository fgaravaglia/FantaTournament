{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Internal.WebHost": "Warning",
        "Microsoft.AspNetCore.StaticFiles.StaticFileMiddleware": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*",
  "Auth0": {
    "Domain": "dev-innovasolutions.eu.auth0.com",
    "Audience": "http://localhost:5093"
  },  
  "ApplicationCatalog": {
    "Name": "FantaTournament",
    "Component": {
      "Name": "API",
      "Description": "The backend API for managing the fantasy football tournament.",
      "Version": "3.0.0"
    }
  },
  "Environment": {
    "Code": "prod",
    "DisplayName": "Production",
    "CloudProjectId": "forecastcup-prod",
    "IsDeployedOnCloud": true
  },
  "Persistence": {
    "BoardProvider": "CSV",
    "ForecastProvider": "JSON",
    "LeagueProvider": "JSON",
    "CsvDataPath": ".\\Data",
    "JsonDataPath": ".\\Data"
  }
}
